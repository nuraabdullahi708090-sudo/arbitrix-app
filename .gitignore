node_modules/
# A worktree that reuses the main checkout's dependencies links node_modules (a
# symlink, which "node_modules/" does not match). Without this, "git add -A" in
# such a worktree stages the link itself.
/node_modules
*.log
.env
.DS_Store

# Browser session files for the live tutorial recording. They contain a login
# token and are NEVER committed.
sandbox-session*.json
storage-state*.json
*.storage-state.json
