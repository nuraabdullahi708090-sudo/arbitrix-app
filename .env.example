# ============================================
# Arbitrix AI - Environment Configuration
# ============================================

# Application URL (for password reset links, etc.)
BASE_URL=https://your-domain.com

# ============================================
# Application Settings
# ============================================

# Environment mode: development or production
NODE_ENV=development

# Server port (default: 8080)
PORT=8080

# ============================================
# Security Configuration (REQUIRED FOR PRODUCTION)
# ============================================
# Generate secure random strings: openssl rand -base64 64

# JWT Secret for signing authentication tokens
# CRITICAL: Use a strong, unique secret in production
JWT_SECRET=your-secure-jwt-secret-here

# Encryption key for TOTP 2FA secrets
# CRITICAL: Use a strong, unique key in production
TOTP_ENCRYPTION_KEY=your-secure-totp-encryption-key-here

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# In production, specify your domain(s)
ALLOWED_ORIGINS=https://arbitrix.pro,https://www.arbitrix.pro

# ============================================
# Email Configuration (Resend SDK)
# ============================================
# Recommended: Use Resend (https://resend.com) for easy setup
# - Free tier: 3,000 emails/month
# - Sign up, add domain, get API key
# - Install: npm install resend

# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# From email address (must be a verified domain in Resend)
EMAIL_FROM=Arbitrix AI <noreply@your-domain.com>

# ============================================
# Rate Limiting Configuration
# ============================================
# Forgot Password Endpoint Rate Limits
# These limits prevent abuse of the password reset functionality

# IP-based rate limit (per IP address)
# Default: 5 requests per 15 minutes
RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW=15

# Email-based rate limit (per email address)
# Default: 3 requests per 60 minutes
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_EMAIL_WINDOW=60

# ============================================
# Supabase Configuration (if using different project)
# ============================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key  # Required in production (startup refuses without it). Required for KYC DB/Storage ops once RLS is enabled on the KYC tables (migration 010). Non-KYC admin ops fall back to anon in dev.

# ============================================
# Payment Provider Configuration
# ============================================
# Active payment provider: 'paymento' | 'q8qpay' | 'nowpayments'
# Paymento remains the default until q8qpay passes end-to-end testing.
PAYMENT_PROVIDER=paymento

# ============================================
# Q8QPay (USDT TRC20 white-label gateway) - NEW
# ============================================
# Get keys from https://q8qpay.com dashboard. Use a test_ key for sandbox.
Q8QPAY_API_KEY=test_your_q8qpay_api_key_here
# Webhook signing secret (used to HMAC-SHA256 verify X-Webhook-Signature).
# Configure the SAME secret in your q8qpay dashboard webhook settings.
Q8QPAY_WEBHOOK_SECRET=your_q8qpay_webhook_secret_here
# Sandbox mode (use a test_ API key). Set to 'true' for E2E testing.
Q8QPAY_SANDBOX=true
# Public, internet-reachable webhook URL that q8qpay will POST to.
# Must be the FULL path. e.g. https://arbitrix.pro/api/webhook/q8qpay
# If omitted, defaults to ${BASE_URL}/api/webhook/q8qpay
Q8QPAY_CALLBACK_URL=https://your-domain.com/api/webhook/q8qpay
# Optional white-label redirect after payment
Q8QPAY_RETURN_URL=https://your-domain.com/deposit

# ============ ARBITRIX PRO SUBSCRIPTION ============
# The Pro subscription ($7/month) is an internal server-side debit of the
# user's available Live balance. It is NOT a payment method and is NOT routed
# through the deposit system. The price is server-controlled and read from the
# `payment_config` DB table (key: subscription.pro_price, default 7). No env var
# is required to enable it; set the price in payment_config to change it.
# (No env var here on purpose — the price must never be client-supplied.)

# ============ MINIMUM TRADING AMOUNT (MTA) ============
# Single source of truth for the PRODUCTION MTA used to START the bot. The
# active production value is 200 (management decision; 143 is retired and 300
# was rejected). Missing/invalid values fall back to the built-in default (200).
# Changing this value = updating this line (or the constant in server.js if the
# default itself should move): every server-side MTA enforcement reads
# getEffectiveMta(), and the frontend adopts the server value, so there is no
# second place to change.
# NOT affected: MARKETING_SANDBOX has NO MTA at all — it never reads this
# variable and applies no minimum trading amount. Also NOT affected: the MTA is
# not a withdrawal requirement (withdrawals are gated by KYC, the $700 minimum,
# balance/address and trade history only).
# Promo-credit-funded trading (no confirmed deposit, positive balance) is exempt
# from the production MTA.
MTA_AMOUNT=200

# ---------------------------------------------------------------------------
# TEMPORARY (management decision): account verification is not required to
# withdraw, so unverified accounts are no longer blocked from withdrawing and
# proceed to the next applicable withdrawal validation.
# Set this to true to RESTORE the previous KYC-first withdrawal gate (the gate
# code is unchanged and merely skipped while the flag is off). Missing/invalid
# values keep the current behavior (verification NOT required).
# SCOPE: only the verification requirement. The minimum withdrawal, the
# completed-trade rule, balance/address validation, the first-deposit rule,
# duplicate/pending protections and authorization are unaffected, and the
# verification system itself is not removed.
WITHDRAWAL_REQUIRES_VERIFICATION=false

# ============================================
# Telegram Support Bot (@ArbitrixSupportBot)
# ============================================
# Optional feature. The app boots normally without these; the /api/telegram/*
# routes simply stay inert (webhook returns 503) until the bot is configured.
#
# Bot token from @BotFather. SECRET: never commit it, never print it. Must be
# set in the host environment (Render), not in this file.
TELEGRAM_BOT_TOKEN=

# Chat id of the private support group the bot forwards user messages to.
# Can be left EMPTY for the first deploy: the bot then accepts /chatid from an
# admin in the group and replies with the group's chat id, which is what you
# paste here. Supergroup ids are negative (e.g. -1001234567890).
TELEGRAM_SUPPORT_CHAT_ID=

# Comma-separated Telegram user ids allowed to run agent commands
# (/reply, /escalate, /close, /chatid). Empty = no one can run them.
TELEGRAM_ADMIN_IDS=

# Secret token Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header. Webhook requests without a matching value are rejected (401).
# SECRET: generate with `openssl rand -hex 32` and configure the same value
# when the webhook is set (see POST /api/telegram/set-webhook).
TELEGRAM_WEBHOOK_SECRET=
# NOTE: the webhook URL is ${BASE_URL}/api/telegram/webhook, so BASE_URL above
# must be the public HTTPS origin of the deployment.
