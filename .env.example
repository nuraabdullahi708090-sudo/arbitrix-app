# ============================================
# Arbitrix AI - Environment Configuration
# ============================================

# Application URL (for password reset links, etc.)
BASE_URL=https://your-domain.com

# ============================================
# Email Configuration (SMTP)
# ============================================
# Recommended: Use Resend (https://resend.com) for easy setup
# - Free tier: 3,000 emails/month
# - Sign up, add domain, get SMTP credentials
#
# Alternative SMTP providers:
# - SendGrid: smtp.sendgrid.net (port 587)
# - AWS SES: email-smtp.us-east-1.amazonaws.com
# - Mailgun: smtp.mailgun.org
# - Gmail: smtp.gmail.com (less reliable, requires app passwords)

# SMTP Host (default: Resend)
SMTP_HOST=smtp.resend.com

# SMTP Port (default: 587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Username (API key for Resend, full username for others)
SMTP_USER=re_your_api_key_here

# SMTP Password (API secret for Resend, password for others)
SMTP_PASS=your_api_secret_here

# From email address (must be verified with your SMTP provider)
EMAIL_FROM=Arbitrix AI <noreply@your-domain.com>

# ============================================
# Supabase Configuration (if using different project)
# ============================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key
