# ============================================
# Arbitrix AI - Environment Configuration
# ============================================

# Application URL (for password reset links, etc.)
BASE_URL=https://your-domain.com

# ============================================
# Application Settings
# ============================================

# Environment mode: development or production
NODE_ENV=development

# Server port (default: 8080)
PORT=8080

# ============================================
# Security Configuration (REQUIRED FOR PRODUCTION)
# ============================================
# Generate secure random strings: openssl rand -base64 64

# JWT Secret for signing authentication tokens
# CRITICAL: Use a strong, unique secret in production
JWT_SECRET=your-secure-jwt-secret-here

# Encryption key for TOTP 2FA secrets
# CRITICAL: Use a strong, unique key in production
TOTP_ENCRYPTION_KEY=your-secure-totp-encryption-key-here

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# In production, specify your domain(s)
ALLOWED_ORIGINS=https://arbitrix.pro,https://www.arbitrix.pro

# ============================================
# Email Configuration (Resend SDK)
# ============================================
# Recommended: Use Resend (https://resend.com) for easy setup
# - Free tier: 3,000 emails/month
# - Sign up, add domain, get API key
# - Install: npm install resend

# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# From email address (must be a verified domain in Resend)
EMAIL_FROM=Arbitrix AI <noreply@your-domain.com>

# ============================================
# Rate Limiting Configuration
# ============================================
# Forgot Password Endpoint Rate Limits
# These limits prevent abuse of the password reset functionality

# IP-based rate limit (per IP address)
# Default: 5 requests per 15 minutes
RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW=15

# Email-based rate limit (per email address)
# Default: 3 requests per 60 minutes
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_EMAIL_WINDOW=60

# ============================================
# Supabase Configuration (if using different project)
# ============================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key  # Required in production (startup refuses without it). Required for KYC DB/Storage ops once RLS is enabled on the KYC tables (migration 010). Non-KYC admin ops fall back to anon in dev.

# ============================================
# Payment Provider Configuration
# ============================================
# Active payment provider: 'paymento' | 'q8qpay' | 'nowpayments'
# Paymento remains the default until q8qpay passes end-to-end testing.
PAYMENT_PROVIDER=paymento

# ============================================
# Q8QPay (USDT TRC20 white-label gateway) - NEW
# ============================================
# Get keys from https://q8qpay.com dashboard. Use a test_ key for sandbox.
Q8QPAY_API_KEY=test_your_q8qpay_api_key_here
# Webhook signing secret (used to HMAC-SHA256 verify X-Webhook-Signature).
# Configure the SAME secret in your q8qpay dashboard webhook settings.
Q8QPAY_WEBHOOK_SECRET=your_q8qpay_webhook_secret_here
# Sandbox mode (use a test_ API key). Set to 'true' for E2E testing.
Q8QPAY_SANDBOX=true
# Public, internet-reachable webhook URL that q8qpay will POST to.
# Must be the FULL path. e.g. https://arbitrix.pro/api/webhook/q8qpay
# If omitted, defaults to ${BASE_URL}/api/webhook/q8qpay
Q8QPAY_CALLBACK_URL=https://your-domain.com/api/webhook/q8qpay
# Optional white-label redirect after payment
Q8QPAY_RETURN_URL=https://your-domain.com/deposit

# ============ ARBITRIX PRO SUBSCRIPTION ============
# The Pro subscription ($7/month) is an internal server-side debit of the
# user's available Live balance. It is NOT a payment method and is NOT routed
# through the deposit system. The price is server-controlled and read from the
# `payment_config` DB table (key: subscription.pro_price, default 7). No env var
# is required to enable it; set the price in payment_config to change it.
# (No env var here on purpose — the price must never be client-supplied.)

# ============ MINIMUM TRADING AMOUNT (MTA) — REMOVED ============
# MTA has been removed from production (management decision). There is no
# minimum live balance required to start the bot, so the MTA_AMOUNT environment
# variable is obsolete and is no longer read. Do NOT set it. MARKETING_SANDBOX
# never had an MTA and is unchanged.

# ---------------------------------------------------------------------------
# TEMPORARY (management decision): account verification is not required to
# withdraw, so unverified accounts are no longer blocked from withdrawing and
# proceed to the next applicable withdrawal validation.
# Set this to true to RESTORE the previous KYC-first withdrawal gate (the gate
# code is unchanged and merely skipped while the flag is off). Missing/invalid
# values keep the current behavior (verification NOT required).
# SCOPE: only the verification requirement. The $500 minimum withdrawal, the
# completed-trade rule, balance/address validation, the first-deposit rule,
# duplicate/pending protections and authorization are unaffected, and the
# verification system itself is not removed.
WITHDRAWAL_REQUIRES_VERIFICATION=false

# ============================================
# Telegram Support Bot (@ArbitrixSupportBot)
# ============================================
# Optional feature. The app boots normally without these; the /api/telegram/*
# routes simply stay inert (webhook returns 503) until the bot is configured.
#
# Bot token from @BotFather. SECRET: never commit it, never print it. Must be
# set in the host environment (Render), not in this file.
#
# Paste the RAW value only. Surrounding quotes, a leading "bot" prefix (as in
# https://api.telegram.org/bot<token>/getMe), or stray whitespace make the value
# malformed; Telegram then answers HTTP 404 "Not Found" to setWebhook, which
# looks like a wrong token but is actually a formatting problem. The server
# normalizes quotes / "bot" prefix / surrounding whitespace, but a truncated
# value cannot be repaired. Diagnose with:
#   node scripts/diagnose-telegram.js
TELEGRAM_BOT_TOKEN=

# Where INTERNAL customer notifications are delivered.
#   admins (default) - one PRIVATE message to every id in TELEGRAM_ADMIN_IDS.
#   group            - the legacy TELEGRAM_SUPPORT_CHAT_ID delivery.
# Leave EMPTY for the default. Any unrecognised value also falls back to
# "admins", so a typo can never silently re-enable group forwarding.
# NOTE: a bot cannot start a conversation, so each admin must have sent /start
# to the bot in a private chat at least once, otherwise that send fails with
# a 403 and is reported in the admin status trace.
TELEGRAM_NOTIFY_TARGET=

# LEGACY: chat id of the support group, used ONLY when
# TELEGRAM_NOTIFY_TARGET=group. Customer notifications go to the admins by
# default, so this can stay EMPTY. Supergroup ids are negative
# (e.g. -1001234567890). The bot answers /chatid with the id to paste here.
# Paste the RAW id: surrounding quotes are stripped automatically, and a quoted
# value used to make the configured group unrecognizable.
TELEGRAM_SUPPORT_CHAT_ID=

# Comma-separated Telegram user ids allowed to run agent commands
# (/reply, /escalate, /close, /chatid). Empty = no one can run them.
# Paste RAW ids; surrounding quotes around each entry are stripped automatically.
TELEGRAM_ADMIN_IDS=

# Secret token Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header. Webhook requests without a matching value are rejected (401).
#
# CHARSET IS ENFORCED BY TELEGRAM: only A-Z a-z 0-9 _ - are accepted, 1-256
# characters. Any other character makes setWebhook fail with
# "Bad Request: secret token contains illegal characters"; Telegram then KEEPS
# the previous registration and the bot silently receives nothing while getMe
# and setWebhook both appear to work.
#
# DO NOT use a base64 secret (e.g. `openssl rand -base64 32`): base64 emits
# "+", "/" and "=", all of which are REJECTED. `openssl rand -hex 32` happens to
# be safe (hex is a subset of a-z0-9), but prefer the project generator, which
# guarantees the alphabet:
#
#   node scripts/generate-telegram-secret.js            # print a new 48-char secret
#   node scripts/generate-telegram-secret.js --check-env # validate the current one
#
# The generated value is the one artifact you copy into this variable. Never
# commit it, log it, or paste it into a report or chat.
TELEGRAM_WEBHOOK_SECRET=
# NOTE: the webhook URL is ${BASE_URL}/api/telegram/webhook, so BASE_URL above
# must be the public HTTPS origin of the deployment.
#
# BOOT RECONCILIATION: on every start the server re-registers the webhook at
# ${BASE_URL}/api/telegram/webhook with the CURRENT secret (after reading
# getWebhookInfo and logging the previous URL / any Telegram delivery error).
# This repairs the "setWebhook + getMe both succeed but the bot never replies"
# state, which happens when the webhook was registered without (or before) the
# secret that is now configured. Set this to false only if you deliberately
# point the webhook somewhere else. The reconciliation never logs a secret value.
# NOTE: `getWebhookInfo` does not report whether a secret_token is registered,
# which is why the boot path always re-asserts instead of comparing state.
TELEGRAM_WEBHOOK_AUTO_REGISTER=true

# ============================================
# SERVER-SIDE TRADING WORKER (node worker.js) - INERT BY DEFAULT
# ============================================
# The production trading loop currently runs in the BROWSER, so it stops when the
# tab is closed/refreshed. `worker.js` is the durable server-side replacement.
# It runs as a SEPARATE process (Render: Background Worker) and is INERT until
# TRADING_WORKER_ENABLED is exactly 'true'. Leave it unset until the worker has
# been reviewed, migrations 028 AND 029 have been applied, and cutover is approved.
#
# PREREQUISITE: migration 028 (supabase/migrations/028_trading_worker.sql) AND
# migration 029 (supabase/migrations/029_bot_session_lease.sql) must be applied.
# The worker FAILS CLOSED without the bot_worker_control row and exits with code
# 1 rather than trading; it also executes nothing when the lease RPCs are absent.
#
# RUN: node worker.js
TRADING_WORKER_ENABLED=false

# Platform-wide KILL SWITCH override. Set 'true' to force trading to stop even if
# the database control row says otherwise (survives DB outages; use during an
# incident). Clear it to resume. The same stop can be engaged at runtime by an
# admin via POST /api/admin/bot/emergency-stop (no redeploy needed).
TRADING_EMERGENCY_STOP=false

# Optional risk limits / tuning. Every value is bounded at runtime and these are
# the defaults the worker uses when the variable is unset or invalid.
TRADING_WORKER_TICK_MS=8000              # evaluation interval (same as the browser loop)
TRADING_MAX_TRADE_PCT=0.5                # the browser's 0.5 factor (0.5 * 2.4% = 1.2% max per trade)
TRADING_MAX_CONSECUTIVE_FAILURES=5       # auto-stop a session after this many RPC failures
#
# STALE HEARTBEAT THRESHOLD - ONE SOURCE OF TRUTH (services/WorkerConfig.js).
# The WORKER uses it to reconcile ("this running session has no executor, stop
# it") and the WEB SERVICE uses it in the /api/trade single-engine guard ("is a
# worker still driving this session?"). If those two windows differed, either a
# browser tab could be refused a session the worker had abandoned, or a browser
# tab could trade while the worker still owned the session.
#
# Therefore: set this variable on BOTH services (web AND background worker) or on
# NEITHER. Both resolve it through the same module, and both report the resolved
# value at runtime (worker: the worker_started log line; web:
# GET /api/admin/bot/worker-status -> staleHeartbeatMs) so a mismatch is visible.
# Unset/invalid falls back to 60000.
# TRADING_STALE_HEARTBEAT_MS=60000
#
# BUSINESS-LOGIC PARITY: the three rails below are DISABLED by default because the
# production browser engine has no such limits. Enabling any of them CHANGES what
# users experience, so it is a management decision, not a deployment detail.
# Leave them unset/commented for exact parity with the current behaviour.
# TRADING_MAX_TRADE_USD=50                # hard ceiling on one trade's magnitude
# TRADING_DAILY_LOSS_LIMIT_USD=100        # stop a session for the rest of the UTC day
# TRADING_MAX_TRADES_PER_DAY=288          # per-user trade cap per UTC day
#
# Executor lease (migration 029). At most one worker instance executes a session.
# TRADING_WORKER_ID=<unique instance id>  # defaults to RENDER_INSTANCE_ID or hostname-pid
# TRADING_WORKER_LEASE_MS=30000           # how long a claimed session stays ours
#
# DRY RUN / SHADOW MODE - the recommended first step at cutover: the worker logs
# exactly what it WOULD write and writes NOTHING (no trade, no heartbeat, no lease).
# TRADING_WORKER_DRY_RUN=true
# TRADING_WORKER_DEBUG=true              # log every tick (very noisy; off by default)
#
# NOTE: the worker writes money ONLY through the existing record_trade_safe()
# RPC. It never writes wallets/trades directly and never touches the marketing
# sandbox (sandbox_* tables/RPCs are not referenced anywhere in the worker).

# ============================================
# AI CUSTOMER SUPPORT (DISABLED BY DEFAULT; Stage 2 wired, Stage 3 providers)
# ============================================
# services/support/SupportAIService.js answers beginner customer questions from
# the approved knowledge base (services/support/arbitrix-knowledge.json). Since
# Stage 2 it is wired into the Telegram support bot as an OPTIONAL collaborator,
# so enabling these variables changes what customers receive in Telegram. If it
# is unavailable for any reason the bot falls back to the standard human-support
# flow (message stored + forwarded to the support group, /escalate intact).
#
# OFF BY DEFAULT. Must be exactly "true" to enable answering.
# When disabled, ask() returns an "automated answers are off" message and hands
# the customer to a human - it performs no retrieval and no generation.
AI_SUPPORT_ENABLED=false

# Provider abstraction. Only 'knowledge' is active by default and it needs NO API
# key and makes NO network calls (it returns the approved knowledge text).
# 'openai', 'anthropic' and 'deepseek' are available as external providers; all
# three stay UNAVAILABLE until an API key is supplied, and an unknown name falls
# back to 'knowledge' so a typo can never enable an external provider.
#
# 'deepseek' uses DeepSeek's OpenAI-compatible chat-completions API
# (https://api.deepseek.com/chat/completions). The approved knowledge base stays
# the source of truth: the model receives ONLY the retrieved approved entries,
# and every answer is safety-checked before it can reach a customer.
AI_SUPPORT_PROVIDER=knowledge

# Model for the HTTP providers only (ignored by 'knowledge').
# Defaults when unset: openai -> gpt-4o-mini,
#                      anthropic -> claude-3-5-haiku-20241022,
#                      deepseek  -> deepseek-chat
AI_SUPPORT_MODEL=

# OPTIONAL. Overrides the endpoint for the OpenAI-compatible 'deepseek' provider
# (for a proxy or self-hosted gateway). A malformed value is ignored and the
# DeepSeek default is used instead.
# AI_SUPPORT_BASE_URL=https://api.deepseek.com

# OPTIONAL and NOT required. Leave EMPTY to keep external providers disabled.
# Read from here first, otherwise from OPENAI_API_KEY / ANTHROPIC_API_KEY /
# DEEPSEEK_API_KEY (matching the selected provider). Never logged, never returned
# by the API, and scrubbed from provider error messages. Never paste a key into
# source control.
AI_SUPPORT_API_KEY=

# HTTP provider timeout (ms). Default 8000.
AI_SUPPORT_TIMEOUT_MS=8000

# Hard ceiling on a generated answer's length. Default 1200.
AI_SUPPORT_MAX_ANSWER_CHARS=1200

# Minimum retrieval score before the bot will answer at all; below this it says
# it does not know and offers a human. Default 2 (one keyword match).
# AI_SUPPORT_MIN_SCORE=2

# ---------------------------------------------------------------------------
# MULTILINGUAL TELEGRAM SUPPORT (en / pt / ar)
# ---------------------------------------------------------------------------
# Customers pick their language with /language (inline keyboard: English /
# Portugues / al-Arabiyya). The choice is stored per conversation in
# telegram_support_conversations.language (migration 032), so it survives
# restarts, webhook restarts, deploys and a customer returning later. A missing,
# NULL or unsupported stored value is resolved to English IN APPLICATION CODE -
# the column has no default and none is relied on.
#
# Operator notifications are ALWAYS in English and carry the customer's ORIGINAL
# message plus an English translation when one can be produced (and an explicit
# "unavailable" marker when it cannot).
#
# Automatic TRANSLATION (customer message -> English for operators, and an
# operator's English reply -> the customer's language) is a SEPARATE gate from AI
# answering: it deliberately keeps working when AI_SUPPORT_ENABLED=false, because
# the human-support workflow must not break. It reuses AI_SUPPORT_PROVIDER and the
# matching API key above; with no credential it reports itself UNAVAILABLE and
# every path degrades safely (localized fixed replies, and the operator's English
# text is sent with a clear notice instead of being silently mistranslated).
#
# PRIVACY: with a credential present, customer messages and operator replies are
# sent to that provider for translation. Set this to false to forbid it entirely.
SUPPORT_TRANSLATION_ENABLED=true

# Optional ceiling on a message the translator will accept (characters). A longer
# message is NOT truncated - it is reported as unavailable and the original is
# shown/sent instead. Default 1500.
# SUPPORT_TRANSLATION_MAX_CHARS=1500
