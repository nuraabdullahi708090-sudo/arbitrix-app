# Environment the rehearsal server ran with.
# Every value is a LOCAL placeholder: the rehearsal copy refuses a non-local
# Supabase host, so these can never reach production.
SMOKE_SUPABASE_URL=http://127.0.0.1:5431
SMOKE_SUPABASE_KEY=smoke-anon-key
SUPABASE_SERVICE_KEY=smoke-service-key
JWT_SECRET=smoke-jwt-secret
PORT=4180
NODE_ENV=development
BASE_URL=http://127.0.0.1:4180

# Payhip, pointed at the local stub (port 5432) with the dummy API key the
# stub's signature scheme expects.
PAYHIP_ENABLED=true
PAYHIP_ACTIVATION_REQUIRED=true
PAYHIP_API_KEY=smoke-payhip-api-key
PAYHIP_WEBHOOK_TOKEN=smoke-webhook-token
PAYHIP_PRODUCTS=activation
PAYHIP_PRODUCT_SECRET=smoke-product-secret
PAYHIP_STORE_URL=https://payhip.com/kalderix
PAYHIP_RETURN_URL=https://arbitrix.pro/?activated=1
PAYHIP_LICENSE_API_BASE=http://127.0.0.1:5432/api/v2

# The release state of decision D2.
PLATFORM_MIN_DEPOSIT_USD=50

# Auth entry-point rate limits. Disabled ONLY for this single-IP local
# rehearsal (dozens of accounts are created from 127.0.0.1 in one run).
# Never set these to 0 in production.
AUTH_RATE_LIMIT_LOGIN_IP_MAX=0
AUTH_RATE_LIMIT_REGISTER_IP_MAX=0

# No administrator is provisioned by the rehearsal. The default seeded
# administrator no longer exists in code; if a scenario needs one, it promotes
# a test user with SQL (see harness.js) or sets ADMIN_PROVISION_* explicitly.
